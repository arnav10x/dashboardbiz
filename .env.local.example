# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Groq API Key (free at console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# Resend (email delivery)
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google Calendar OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe Connect (OAuth) — required for the "Connect with Stripe" button
# Register at dashboard.stripe.com → Settings → Connect → Get started
STRIPE_CLIENT_ID=ca_test_your_connect_client_id
STRIPE_SECRET_KEY=sk_test_your_platform_secret_key
# NEXT_PUBLIC_SITE_URL above must match your Stripe redirect URI
