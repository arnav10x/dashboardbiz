# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Groq API Key (free at console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# Resend (email delivery)
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google Calendar OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe Connect OAuth (dashboard.stripe.com → Connect → Settings)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_CLIENT_ID=ca_...

# Stripe Connect Platform (V2)
# Create a recurring price in Stripe Dashboard → Products → Add product
STRIPE_PRICE_ID=price_...
# Webhook signing secrets (Developers → Webhooks → + Add destination)
# V2 thin events endpoint: /api/stripe/webhooks/v2
STRIPE_WEBHOOK_SECRET_V2=whsec_...
# V1 subscription events endpoint: /api/stripe/webhooks/subscriptions
STRIPE_WEBHOOK_SECRET_SUBS=whsec_...
